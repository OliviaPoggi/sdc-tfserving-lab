{
  "name": "tfserving-lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8501, 8601],
  "portsAttributes": {
    "8501": { "label": "Streamlit frontend" },
    "8601": { "label": "TensorFlow Serving" }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}

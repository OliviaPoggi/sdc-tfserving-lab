# TensorFlow Serving model configuration.
#
# Follows the pattern shown in class (models.config gist): instead of passing
# --model_name / --model_base_path on the command line, TensorFlow Serving is
# started with --model_config_file, which supports several models and explicit
# version policies.
#
# Only version 1 is exported by the model-init container. To serve several
# versions, export them as /models/mobilenet/2, /models/mobilenet/3, ... and
# extend the policy below, for example:
#
#   model_version_policy { specific { versions: 1  versions: 2 } }
#   version_labels { key: 'stable'   value: 1 }
#   version_labels { key: 'canary'   value: 2 }
#
# Note: version_labels only accept versions that are already loaded.

model_config_list {
  config {
    name: 'mobilenet'
    base_path: '/models/mobilenet/'
    model_platform: 'tensorflow'

    model_version_policy {
      specific {
        versions: 1
      }
    }
  }
}
